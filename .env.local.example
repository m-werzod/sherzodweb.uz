# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# ── TELEGRAM BOT ──────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot
# 2. Follow steps → copy the token it gives you
TELEGRAM_BOT_TOKEN=your_bot_token_here

# How to get your Chat ID:
# 1. Start a chat with your new bot (send it /start)
# 2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Find "chat":{"id": 123456789 } — that number is your Chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# ── GMAIL SMTP (Nodemailer) ────────────────────────────────────
# 1. Go to your Google Account → Security → 2-Step Verification (enable it)
# 2. Then go to: https://myaccount.google.com/apppasswords
# 3. Select app: Mail → Select device: Other → name it "Portfolio"
# 4. Copy the 16-character password Google gives you
GMAIL_USER=sherzodusmonjonov734@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
