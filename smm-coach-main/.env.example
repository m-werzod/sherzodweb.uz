# ============================================================================
# SMM — AI Instagram Growth Coach. Local development env template.
# Copy to .env and fill in actual values. Never commit .env.
# ============================================================================

# --- Core ----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------
# Used by Prisma (apps/web, packages/db) and by LangGraph PostgresSaver (apps/agents).
DATABASE_URL=postgresql://smm:smm@localhost:5432/smm?schema=public
DIRECT_URL=postgresql://smm:smm@localhost:5432/smm?schema=public

# --- Redis (Streams + PubSub) -------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth.js v5 ---------------------------------------------------------
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Platform-admin allowlist for /admin (comma-separated emails). Added ON TOP of
# the always-admin built-ins (founder + admin@brotech.uz) — never replaces them.
ADMIN_EMAILS=matsalayev03@gmail.com

# Bootstrap admin account, created idempotently on web boot (instrumentation.ts)
# so a known credentials login exists. Defaults shown; change before first boot
# to set a stronger password (create-if-missing — won't update an existing row).
ADMIN_BOOTSTRAP_EMAIL=admin@brotech.uz
ADMIN_BOOTSTRAP_PASSWORD=admin123
# BOOTSTRAP_ADMIN_DISABLED=1   # set to skip creating the bootstrap admin

# Google OAuth (optional in dev; required in prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic-link (SMTP)
AUTH_EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
AUTH_EMAIL_FROM=no-reply@smm.local

# --- AI providers -------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Voyage AI — embeddings (voyage-3, 1024-dim, normalized). Preferred over OpenAI for retrieval.
VOYAGE_API_KEY=
# Optional fallback / experiments
OPENAI_API_KEY=
# Cerebras — ultra-fast Llama 3.3 70B / Qwen (OpenAI-compatible). DEFAULT engine
# for high-volume agent tasks (scoring, enrichment, market/industry synthesis).
CEREBRAS_API_KEY=
# OpenRouter — one key, many models (Llama/Qwen/DeepSeek/…); used when Cerebras unset.
OPENROUTER_API_KEY=

# --- Higgsfield AI (cinematic video / image / talking-avatar generation) ---
# Server-only. Set HF_CREDENTIALS in "KEY_ID:KEY_SECRET" form (the format the
# Higgsfield dashboard issues), OR the two separate vars below. Without it, the
# "AI video" panel in the task brief stays hidden. Generation spends Higgsfield
# credits (your account).
HF_CREDENTIALS=
# HF_API_KEY=
# HF_API_SECRET=
# Optional override (defaults to https://platform.higgsfield.ai)
# HIGGSFIELD_BASE_URL=

# --- Instagram --------------------------------------------------------- -
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback/instagram
# Used while waiting for Meta App Review Advanced Access
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Instagram scraping (MVP path) --------------------------------------
# Throwaway accounts only — NEVER your personal handle. Use 2-3 for rotation.
# Format: JSON array of {username, password, proxy?}
# Example:
# IG_SCRAPER_ACCOUNTS=[{"username":"smm_scout_01","password":"xxx","proxy":"http://u:p@host:port"},{"username":"smm_scout_02","password":"xxx"}]
IG_SCRAPER_ACCOUNTS=

# Optional residential proxy (BrightData / Smartproxy / Oxylabs) — reduces ban risk
IG_SCRAPER_PROXY_URL=

# --- Payments (UZ: Payme; later: Click, Stripe) --------------------------
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# --- Object storage (Cloudflare R2) -------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smm-media
R2_PUBLIC_BASE_URL=

# --- Avatar / TTS -------------------------------------------------------
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
# UzbekVoice.ai — Uzbek TTS for the voice coach (PRIMARY). Sent as the RAW
# `Authorization` header (NOT "Bearer"). Voice model 'lola'; 1.2x speed is
# applied client-side. Get a key at https://uzbekvoice.ai/en-US/developers
UZBEKVOICE_API_KEY=
# UZBEKVOICE_TTS_MODEL=lola
# Aisha — Uzbek TTS (back.aisha.group). Legacy/alt; no longer used by the coach.
AISHA_API_KEY=

# --- Montaj media / GPU-plane -------------------------------------------
# Stock B-roll (Pexels bepul API) — footage yetmagan shotlarni to'ldiradi.
PEXELS_API_KEY=
# fal.ai — generativ b-roll (Kling) + inpaint (void element-removal). BITTA kalit ikkalasiga.
# Olish: https://fal.ai/dashboard/keys (biznes-email → $20 bepul kredit). Kalitsiz: gen/inpaint
# inert (xato bermaydi) — montaj stock'ga tushadi.
FAL_KEY=
# Gen-broll'ni yoqadi (opt-in cinematic; ~$1.4/klip Kling 5s, har montajda ≤4). Default off.
ENABLE_GEN_BROLL=false
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video
# Inpaint (ortiqcha element tozalash) — task meta.inpaintRemove ("person") bo'lsa ishlaydi
# (~$0.05/video, SAM-3 matn-mask, mask UI yo'q). Default off.
ENABLE_INPAINT=false
# FAL_INPAINT_MODEL=fal-ai/void-video-inpainting

# --- Higgsfield (kinematik per-kadr AI video) ---------------------------
# Senariy storyboard (shotList) → har kadrga image→video (Higgsfield DoP) → o'z kompilyatorimiz
# musiqa+subtitr bilan yig'adi. Fail-soft; default o'chiq (pullik, har klip alohida to'lov).
# Auth Eski lib/higgsfield BILAN BIR XIL kalitni ishlatadi (V2 "Key ID:SECRET") — yangi kalit
# SHART EMAS. Yuqoridagi HF_API_KEY + HF_API_SECRET (yoki HF_CREDENTIALS="ID:SECRET") yetadi.
# Keyframe uchun FAL_KEY (fal FLUX) ham kerak (yuqorida bor).
#
# Yoqish uchun BITTA bayroq (web + agents shared env'da) — o'chiq bo'lsa Production tugmasi
# ko'rinmaydi va render ishlamaydi:
ENABLE_HIGGSFIELD=false
# HIGGSFIELD_VIDEO_MODEL=dop-turbo               # dop-lite | dop-turbo | dop-standard
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# HIGGSFIELD_IMAGE_MODEL=fal-ai/flux/schnell     # keyframe still (fal FLUX; FAL_KEY kerak)
# Kamera-harakat presetlari — Higgsfield motion UUID; nom→id JSON (Higgsfield hujjatidan). Bo'sh
# bo'lsa kamera harakati faqat prompt matnida boradi (ixtiyoriy):
# HIGGSFIELD_MOTION_CATALOG={"orbit":"<uuid>","push_in":"<uuid>","static":"<uuid>"}

# --- Shotstack (cloud RENDER plane — MONTAGE-PRO F1) ---------------------
# EDL miyasi bizda qoladi; polish-render Shotstack bulutida (server CPU'dan yuk ketadi — 10k+
# mijoz masshtabi). Fail-soft: bulut xatosi lokal ffmpeg ladder'ga tushadi. Sandbox uchun
# shotstack.io'da bepul "stage" kalit oling (watermark bilan, POC uchun yetadi):
ENABLE_SHOTSTACK=false
SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=stage        # stage (sandbox, watermark) | v1 (production)

# --- Observability ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# --- Inter-service security ---------------------------------------------
# HMAC shared secret between apps/web and apps/agents
AGENTS_BASE_URL=http://localhost:8000
AGENTS_HMAC_SECRET=replace-with-openssl-rand-hex-32

# --- STUDIO (browser montage editor, separate origin) -------------------
# Origin of the deployed STUDIO editor. Unset → the "Montaj studiyasi" deep-link
# falls back to the in-app studio page. e.g. https://studio.brotech.uz
STUDIO_URL=
# HMAC secret signing the short-lived save-back token handed to STUDIO. Falls
# back to AGENTS_HMAC_SECRET when unset; set a distinct value in prod.
STUDIO_SAVE_SECRET=

# --- Scheduled auto-publish -------------------------------------------------
# Shared secret guarding POST /api/cron/publish-due (web) — the agents
# publish_scheduler worker sends it as x-cron-secret. Falls back to
# AGENTS_HMAC_SECRET when unset.
CRON_SECRET=
# (agents service) the web origin the publish_scheduler polls. Without it the
# scheduler is a no-op. e.g. https://smm.brotech.uz
WEB_URL=

# --- Feature flags ------------------------------------------------------
ENABLE_HEYGEN_AVATAR=false
ENABLE_AUTO_PUBLISH=false
