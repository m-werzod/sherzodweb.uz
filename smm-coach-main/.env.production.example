# ============================================================================
# PRODUCTION ENV TEMPLATE — Coolify deployment for SMM Coach
#
# Paste these into Coolify → smm-coach project → Environment Variables.
# Coolify auto-fills SERVICE_FQDN_WEB_3000 (and SERVICE_FQDN_MINIO_*) when
# you bind a domain to the matching service. Everything else you fill in.
#
# Variable names MATCH the code (apps/web/src/lib/auth/auth.ts uses
# AUTH_GOOGLE_ID, apps/agents/app/config.py uses GEMINI_API_KEY). Do not
# rename them.
# ============================================================================

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=smm
POSTGRES_PASSWORD=                        # GENERATE: openssl rand -base64 24
POSTGRES_DB=smm

# ---- Auth.js (NextAuth) -----------------------------------------------------
AUTH_SECRET=                              # GENERATE: openssl rand -base64 48
# NEXTAUTH_URL / AUTH_URL is auto-set by Coolify from SERVICE_FQDN_WEB_3000

# ---- Inter-service HMAC -----------------------------------------------------
AGENTS_HMAC_SECRET=                       # GENERATE: openssl rand -base64 48

# ---- Google OAuth (Auth.js — "Google bilan kirish" button) -----------------
# Console: https://console.cloud.google.com/apis/credentials
# Authorized JS origin:   https://smm.brotech.uz
# Authorized redirect:    https://smm.brotech.uz/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Instagram (Meta Business Login + Graph API) ----------------------------
# https://developers.facebook.com/apps/<app-id>/instagram-business
# OAuth Redirect URI:   https://smm.brotech.uz/api/auth/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---- LLM providers (best-of-breed routing) --------------------------------
# Anthropic — primary creative (Opus 4) + critique (Sonnet 4.6) + validators (Haiku 4.5)
# Get: https://console.anthropic.com/settings/billing — deposit $50 for testing
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini — multilingual (Uzbek), 1M context, Imagen 3, embeddings
# Get: https://aistudio.google.com/apikey — deposit $20 for testing
GEMINI_API_KEY=

# Groq — Llama 3.3 70B (700 tok/sec) for fast classifiers + Whisper Large v3
# Get: https://console.groq.com/keys — FREE tier (14,400 req/day)
GROQ_API_KEY=

# OpenAI — Whisper transcription, DALL-E backup, GPT-4o emergency fallback
# Get: https://platform.openai.com/api-keys — deposit $20 for testing
OPENAI_API_KEY=

# Voyage — DEPRECATED; we now use Gemini text-embedding-004 (free). Kept for
# backward compatibility with seed scripts; can be left blank.
VOYAGE_API_KEY=

# ElevenLabs — best-in-class TTS for voiceover
# Get: https://elevenlabs.io — Creator $22/month for voice cloning
ELEVENLABS_API_KEY=

# ---- Media generation (Premium tier features — soft-disabled if blank) ----
# HeyGen — talking-head avatar video for Premium tier ($1/min)
# Get: https://app.heygen.com/settings/api — $25 credit
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=

# Runway Gen-3 — AI video generation for B-roll
# Get: https://runwayml.com/pricing — Standard $15/month = 625 credits ≈ 5 min
RUNWAY_API_KEY=

# ---- Background workers (agents) — REQUIRED in prod ------------------------
# RUN_WORKERS MUST be 1 in production: the run_worker is the ONLY thing that
# CLAIMS + DRIVES queued agent runs. With it off, onboarding dispatches a
# roadmap_generation run that stays 'queued' FOREVER and new users are stuck on
# the loading screen — the product is unusable. WORKER_SET=all runs both the
# brain (run_worker, schedulers) and the media plane (montage_worker).
RUN_WORKERS=1
WORKER_SET=all

# ---- Instagram scraping (instagrapi — throwaway accounts) -------------------
# JSON array. Provision 2-3 fresh IG accounts (NOT personal). Leave empty if
# you only rely on Meta OAuth + public Playwright probe.
IG_SCRAPER_ACCOUNTS=
IG_SCRAPER_PROXY_URL=
# Official competitor data (business_discovery) — one FB-Login-connected account's
# token reads ANY public competitor; no proxy/scraper needed. See META_APP_REVIEW.md.
IG_GRAPH_SERVICE_TOKEN=
IG_GRAPH_SERVICE_USER_ID=

# ---- Object storage (MinIO — runs inside our stack) ------------------------
# Self-hosted S3-compatible. Credentials match the MinIO container.
# Set SERVICE_FQDN_MINIO_9000 by binding a public domain (e.g. cdn.brotech.uz)
# to the `minio` service in Coolify so signed-URL downloads work in the browser.
S3_ACCESS_KEY_ID=                         # GENERATE: openssl rand -hex 12
S3_SECRET_ACCESS_KEY=                     # GENERATE: openssl rand -base64 32
S3_BUCKET=smm-media

# ---- STUDIO (browser montage editor — separate, hand-managed container) ----
# Origin of the deployed STUDIO editor; unset → "Montaj studiyasi" falls back to
# the in-app studio page. See /opt/smm-studio.env + the smm-studio-redeploy
# script on the host (STUDIO is NOT in the Coolify atomic deploy).
STUDIO_URL=                               # e.g. https://studio.brotech.uz
STUDIO_SAVE_SECRET=                       # GENERATE: openssl rand -base64 48 (distinct from AGENTS_HMAC_SECRET)

# ---- Payme (UZ payments) — secret key for sandbox; merchant ID later -------
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true
